# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ── Auth ───────────────────────────────────────────────
# Must be at least 32 characters. Use a long random string.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Allow $plain$-prefixed seeded passwords to log in.
# Keep this false in production.
ALLOW_PLAIN_SEEDED_PASSWORDS=false

# ── Database (Supabase Postgres) ───────────────────────
# Use the pooled or direct connection string from Supabase.
SUPABASE_DATABASE_URL=postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_SSL=true

# Optional pool tuning
SUPABASE_DB_POOL_MAX=10
SUPABASE_DB_IDLE_TIMEOUT_MS=30000
SUPABASE_DB_CONNECTION_TIMEOUT_MS=10000
